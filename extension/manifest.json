{
  "manifest_version": 3,
  "name": "BlockAI",
  "short_name": "blockai",
  "version": "1.0.9",
  "description": "Проверяет VPN перед доступом к Claude — без утечки IP",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BlockAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.country.is/*",
    "https://get.geojs.io/*",
    "https://ipinfo.io/*",
    "https://ifconfig.co/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://claude.com/*",
    "*://*.claude.com/*",
    "*://anthropic.com/*",
    "*://*.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://claude.com/*",
        "*://*.claude.com/*",
        "*://anthropic.com/*",
        "*://*.anthropic.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_claude",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
